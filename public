<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Horror Channel Automation</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      color: #ecf0f1;
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    header {
      text-align: center;
      margin-bottom: 40px;
      border-bottom: 2px solid #e74c3c;
      padding-bottom: 20px;
    }

    h1 {
      font-size: 2.5em;
      margin-bottom: 10px;
      color: #e74c3c;
    }

    .subtitle {
      font-size: 1.1em;
      color: #bdc3c7;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .card {
      background: #0f3460;
      border: 1px solid #e74c3c;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    }

    .card h2 {
      color: #e74c3c;
      margin-bottom: 15px;
      font-size: 1.5em;
    }

    .stat {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid #16213e;
    }

    .stat:last-child {
      border-bottom: none;
    }

    .stat-label {
      color: #bdc3c7;
    }

    .stat-value {
      color: #2ecc71;
      font-weight: bold;
      font-size: 1.2em;
    }

    .status-badge {
      display: inline-block;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 0.9em;
      font-weight: bold;
    }

    .status-active {
      background: #2ecc71;
      color: #1a1a2e;
    }

    .status-inactive {
      background: #e67e22;
      color: #1a1a2e;
    }

    form {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    input, select, textarea {
      flex: 1;
      min-width: 150px;
      padding: 10px;
      background: #16213e;
      border: 1px solid #e74c3c;
      color: #ecf0f1;
      border-radius: 4px;
      font-family: inherit;
    }

    input::placeholder, textarea::placeholder {
      color: #7f8c8d;
    }

    textarea {
      resize: vertical;
      min-height: 80px;
    }

    button {
      padding: 10px 20px;
      background: #e74c3c;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
      transition: background 0.3s;
      white-space: nowrap;
    }

    button:hover {
      background: #c0392b;
    }

    button:disabled {
      background: #7f8c8d;
      cursor: not-allowed;
    }

    .btn-secondary {
      background: #3498db;
    }

    .btn-secondary:hover {
      background: #2980b9;
    }

    .btn-danger {
      background: #e74c3c;
    }

    .btn-danger:hover {
      background: #c0392b;
    }

    .story-list {
      display: grid;
      gap: 15px;
      max-height: 500px;
      overflow-y: auto;
      margin-top: 15px;
    }

    .story-item {
      background: #16213e;
      border-left: 4px solid #e74c3c;
      padding: 15px;
      border-radius: 4px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .story-info {
      flex: 1;
    }

    .story-title {
      font-weight: bold;
      color: #2ecc71;
      margin-bottom: 5px;
    }

    .story-type {
      font-size: 0.9em;
      color: #bdc3c7;
    }

    .story-used {
      color: #e74c3c;
      font-weight: bold;
      margin-left: 10px;
    }

    .story-actions {
      display: flex;
      gap: 5px;
    }

    .story-actions button {
      padding: 5px 10px;
      font-size: 0.9em;
    }

    .scripts-list {
      display: grid;
      gap: 15px;
      max-height: 600px;
      overflow-y: auto;
    }

    .script-card {
      background: #16213e;
      border: 1px solid #2ecc71;
      border-radius: 4px;
      padding: 15px;
    }

    .script-title {
      color: #2ecc71;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .script-meta {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
      margin-bottom: 10px;
      font-size: 0.9em;
      color: #bdc3c7;
    }

    .script-content {
      background: #0f3460;
      padding: 10px;
      border-radius: 4px;
      max-height: 200px;
      overflow-y: auto;
      font-family: 'Courier New', monospace;
      font-size: 0.85em;
      color: #ecf0f1;
      margin-bottom: 10px;
    }

    .message {
      padding: 15px;
      border-radius: 4px;
      margin-bottom: 15px;
      display: none;
    }

    .message.success {
      background: #27ae60;
      color: white;
      display: block;
    }

    .message.error {
      background: #c0392b;
      color: white;
      display: block;
    }

    .message.info {
      background: #3498db;
      color: white;
      display: block;
    }

    .loading {
      display: inline-block;
      width: 20px;
      height: 20px;
      border: 3px solid #7f8c8d;
      border-radius: 50%;
      border-top-color: #e74c3c;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
      border-bottom: 2px solid #16213e;
    }

    .tab-button {
      padding: 10px 20px;
      background: transparent;
      color: #bdc3c7;
      border: none;
      border-bottom: 3px solid transparent;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.3s;
    }

    .tab-button.active {
      color: #e74c3c;
      border-bottom-color: #e74c3c;
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .action-buttons {
      display: flex;
      gap: 10px;
      margin-top: 20px;
      flex-wrap: wrap;
    }

    @media (max-width: 768px) {
      h1 {
        font-size: 1.8em;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      form {
        flex-direction: column;
      }

      input, select, textarea {
        min-width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>👻 Horror Channel Automation</h1>
      <p class="subtitle">Automated script generation for narrated horror stories</p>
    </header>

    <div id="message" class="message"></div>

    <!-- Status Cards -->
    <div class="grid">
      <div class="card">
        <h2>📊 Channel Status</h2>
        <div class="stat">
          <span class="stat-label">Total Stories</span>
          <span class="stat-value" id="totalStories">0</span>
        </div>
        <div class="stat">
          <span class="stat-label">Used Stories</span>
          <span class="stat-value" id="usedStories">0</span>
        </div>
        <div class="stat">
          <span class="stat-label">Remaining</span>
          <span class="stat-value" id="unusedStories">0</span>
        </div>
        <div class="stat">
          <span class="stat-label">Mode</span>
          <span class="status-badge" id="modeStatus">Active</span>
        </div>
      </div>

      <div class="card">
        <h2>📝 Scripts Generated</h2>
        <div class="stat">
          <span class="stat-label">Total Scripts</span>
          <span class="stat-value" id="totalScripts">0</span>
        </div>
        <div class="stat">
          <span class="stat-label">Last Generated</span>
          <span class="stat-value" id="lastGenerated">Never</span>
        </div>
        <div class="stat">
          <span class="stat-label">Next Scheduled</span>
          <span class="stat-value" id="nextScheduled">9:00 AM</span>
        </div>
      </div>

      <div class="card">
        <h2>⚙️ System</h2>
        <div class="stat">
          <span class="stat-label">API Status</span>
          <span class="status-badge" id="apiStatus">Checking...</span>
        </div>
        <div class="stat">
          <span class="stat-label">Uptime</span>
          <span class="stat-value" id="uptime">Just started</span>
        </div>
        <button style="width: 100%; margin-top: 10px;" onclick="location.reload()">Refresh Status</button>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
      <button class="tab-button active" onclick="switchTab('stories')">📚 Story Ideas</button>
      <button class="tab-button" onclick="switchTab('generate')">✨ Generate Scripts</button>
      <button class="tab-button" onclick="switchTab('scripts')">📄 Generated Scripts</button>
    </div>

    <!-- Stories Tab -->
    <div id="stories" class="tab-content active">
      <div class="card">
        <h2>Manage Story Ideas</h2>
        
        <form id="addStoryForm">
          <input type="text" id="storyTitle" placeholder="Story Title" required>
          <select id="storyType" required>
            <option value="">Select Type...</option>
            <option value="Creepypasta">Creepypasta</option>
            <option value="Japanese">Japanese/Mystical</option>
            <option value="Paranormal">Paranormal/True Case</option>
            <option value="Psychological">Psychological</option>
            <option value="Original">Original</option>
          </select>
          <textarea id="storyDescription" placeholder="Brief description..."></textarea>
          <button type="submit">➕ Add Story</button>
        </form>

        <div class="story-list" id="storyList">
          <p style="color: #7f8c8d;">Loading stories...</p>
        </div>

        <div class="action-buttons">
          <button class="btn-secondary" onclick="loadStories()">🔄 Refresh List</button>
          <button class="btn-danger" onclick="resetStories()">⚠️ Reset All Stories</button>
        </div>
      </div>
    </div>

    <!-- Generate Tab -->
    <div id="generate" class="tab-content">
      <div class="card">
        <h2>Generate Scripts Now</h2>
        <p style="color: #bdc3c7; margin-bottom: 15px;">Select a story to generate long-form + 2 shorts scripts</p>
        
        <div id="generateContainer">
          <p style="color: #7f8c8d;">Loading stories...</p>
        </div>

        <div class="action-buttons">
          <button class="btn-secondary" onclick="loadGenerateOptions()">🔄 Refresh Options</button>
        </div>
      </div>
    </div>

    <!-- Scripts Tab -->
    <div id="scripts" class="tab-content">
      <div class="card">
        <h2>📄 Generated Scripts (Latest 10)</h2>
        <div class="scripts-list" id="scriptsList">
          <p style="color: #7f8c8d;">Loading scripts...</p>
        </div>

        <div class="action-buttons">
          <button class="btn-secondary" onclick="loadScripts()">🔄 Refresh Scripts</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const API_BASE = '/api';
    let startTime = Date.now();

    document.getElementById('addStoryForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      await addStory();
    });

    function switchTab(tabName) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));
      document.getElementById(tabName).classList.add('active');
      event.target.classList.add('active');

      if (tabName === 'stories') loadStories();
      if (tabName === 'generate') loadGenerateOptions();
      if (tabName === 'scripts') loadScripts();
    }

    async function loadStories() {
      try {
        const res = await fetch(`${API_BASE}/stories`);
        const stories = await res.json();
        
        const html = stories.map(s => `
          <div class="story-item">
            <div class="story-info">
              <div class="story-title">${s.title}</div>
              <div class="story-type">${s.type} ${s.used ? '<span class="story-used">✓ Used</span>' : ''}</div>
              <div style="font-size: 0.85em; color: #95a5a6; margin-top: 5px;">${s.description || 'No description'}</div>
            </div>
            <div class="story-actions">
              <button class="btn-danger" onclick="deleteStory(${s.id})">🗑️</button>
            </div>
          </div>
        `).join('');
        
        document.getElementById('storyList').innerHTML = html || '<p style="color: #7f8c8d;">No stories yet. Add one above!</p>';
      } catch (err) {
        showMessage('Error loading stories', 'error');
      }
    }

    async function loadGenerateOptions() {
      try {
        const res = await fetch(`${API_BASE}/stories`);
        const stories = await res.json();
        const unusedStories = stories.filter(s => !s.used);
        
        if (unusedStories.length === 0) {
          document.getElementById('generateContainer').innerHTML = '<p style="color: #e74c3c;">No unused stories. Add more or reset all.</p>';
          return;
        }

        const html = unusedStories.map(s => `
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px; background: #16213e; border-radius: 4px; margin-bottom: 10px;">
            <div>
              <div style="font-weight: bold; color: #2ecc71;">${s.title}</div>
              <div style="font-size: 0.9em; color: #bdc3c7;">${s.type}</div>
            </div>
            <button class="btn-secondary" onclick="generateScripts(${s.id})">Generate</button>
          </div>
        `).join('');
        
        document.getElementById('generateContainer').innerHTML = html;
      } catch (err) {
        showMessage('Error loading options', 'error');
      }
    }

    async function addStory() {
      const title = document.getElementById('storyTitle').value;
      const type = document.getElementById('storyType').value;
      const description = document.getElementById('storyDescription').value;

      try {
        const res = await fetch(`${API_BASE}/stories`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, type, description })
        });

        if (res.ok) {
          showMessage('✅ Story added!', 'success');
          document.getElementById('addStoryForm').reset();
          loadStories();
        }
      } catch (err) {
        showMessage('Error adding story', 'error');
      }
    }

    async function deleteStory(id) {
      if (!confirm('Delete this story?')) return;
      
      try {
        await fetch(`${API_BASE}/stories/${id}`, { method: 'DELETE' });
        showMessage('✅ Story deleted!', 'success');
        loadStories();
      } catch (err) {
        showMessage('Error deleting story', 'error');
      }
    }

    async function generateScripts(storyId) {
      const btn = event.target;
      btn.disabled = true;
      btn.innerHTML = '<div class="loading"></div>';

      try {
        const res = await fetch(`${API_BASE}/generate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ storyId })
        });

        if (res.ok) {
          showMessage('✅ Scripts generated! Check the Scripts tab.', 'success');
          loadGenerateOptions();
          loadScripts();
          updateStatus();
        } else {
          const error = await res.json();
          showMessage(`Error: ${error.error}`, 'error');
        }
      } catch (err) {
        showMessage('Generation error: ' + err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = 'Generate';
      }
    }

    async function loadScripts() {
      try {
        const res = await fetch(`${API_BASE}/scripts`);
        const scripts = await res.json();

        if (scripts.length === 0) {
          document.getElementById('scriptsList').innerHTML = '<p style="color: #7f8c8d;">No scripts generated yet.</p>';
          return;
        }

        const html = scripts.map(s => `
          <div class="script-card">
            <div class="script-title">${s.storyTitle}</div>
            <div class="script-meta">
              <div><strong>Type:</strong> ${s.storyType}</div>
              <div><strong>Tone:</strong> ${s.narratorTone}</div>
              <div><strong>Generated:</strong> ${new Date(s.generatedAt).toLocaleString()}</div>
            </div>
            
            <div style="margin-bottom: 10px;">
              <strong style="color: #e74c3c;">Long-Form (${s.longForm.duration})</strong>
              <div class="script-content">${s.longForm.narration}</div>
            </div>

            <div style="margin-bottom: 10px;">
              <strong style="color: #3498db;">Hook Short (${s.hookShort.duration})</strong>
              <div class="script-content">${s.hookShort.narration}</div>
            </div>

            <div style="margin-bottom: 10px;">
              <strong style="color: #9b59b6;">Climax Short (${s.climaxShort.duration})</strong>
              <div class="script-content">${s.climaxShort.narration}</div>
            </div>

            <div style="font-size: 0.9em; color: #bdc3c7;">
              <strong>Warnings:</strong> ${s.contentWarnings}<br>
              <strong>Tips:</strong> ${s.tips}
            </div>
          </div>
        `).join('');

        document.getElementById('scriptsList').innerHTML = html;
      } catch (err) {
        showMessage('Error loading scripts', 'error');
      }
    }

    async function updateStatus() {
      try {
        const res = await fetch(`${API_BASE}/status`);
        const status = await res.json();

        document.getElementById('totalStories').textContent = status.totalStories;
        document.getElementById('usedStories').textContent = status.usedStories;
        document.getElementById('unusedStories').textContent = status.unusedStories;
        document.getElementById('totalScripts').textContent = status.generatedScripts;
        document.getElementById('modeStatus').textContent = status.researchMode ? '🔬 Research Mode' : '✅ Active';
        document.getElementById('nextScheduled').textContent = new Date(status.nextScheduledGeneration).toLocaleTimeString();
        document.getElementById('apiStatus').textContent = '✅ Connected';
        document.getElementById('apiStatus').className = 'status-badge status-active';
        document.getElementById('uptime').textContent = getUptime();
      } catch (err) {
        document.getElementById('apiStatus').textContent = '❌ Error';
        document.getElementById('apiStatus').className = 'status-badge status-inactive';
      }
    }

    async function resetStories() {
      if (!confirm('Reset ALL stories? They will all be marked as unused.')) return;

      try {
        const res = await fetch(`${API_BASE}/reset`, { method: 'POST' });
        if (res.ok) {
          showMessage('✅ All stories reset!', 'success');
          loadStories();
          updateStatus();
        }
      } catch (err) {
        showMessage('Error resetting stories', 'error');
      }
    }

    function showMessage(text, type) {
      const msg = document.getElementById('message');
      msg.textContent = text;
      msg.className = `message ${type}`;
      setTimeout(() => msg.className = 'message', 5000);
    }

    function getUptime() {
      const seconds = Math.floor((Date.now() - startTime) / 1000);
      if (seconds < 60) return `${seconds}s`;
      const minutes = Math.floor(seconds / 60);
      if (minutes < 60) return `${minutes}m`;
      const hours = Math.floor(minutes / 60);
      return `${hours}h`;
    }

    loadStories();
    updateStatus();
    setInterval(updateStatus, 30000);
  </script>
</body>
</html>
